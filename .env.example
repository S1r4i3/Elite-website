# ─────────────────────────────────────────────────────────────
# Elite B Tax Services — website environment
# Copy to .env.local for development. On Vercel, add each of
# these under Project → Settings → Environment Variables.
# NEVER commit real secrets to this file.
# ─────────────────────────────────────────────────────────────

# Public address of the site. Used for canonical URLs and for the
# links inside verification / notification emails.
NEXT_PUBLIC_SITE_URL=https://www.elitebtax.com
APP_URL=https://www.elitebtax.com

# ── Database ────────────────────────────────────────────────
# Leave empty to use the local JSON file store (.data/db.json) in development.
# In production this must be set. Run `npm run db:migrate` once after setting it.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/elite_tax
# Managed providers (Neon, Supabase, RDS) need TLS:
DATABASE_SSL=true

# ── Sessions & admin ────────────────────────────────────────
# 64 random hex characters:  openssl rand -hex 32
SESSION_SECRET=
# Password for the built-in /admin pages on the website
ADMIN_PASSWORD=
# Bearer token the separate admin dashboard uses to call /api/v1/admin/*
# Generate another one:  openssl rand -hex 32
ADMIN_API_TOKEN=

# ── Email (Gmail app password) ──────────────────────────────
# Google Account → Security → 2-Step Verification → App passwords.
# Use the 16-character app password, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_FROM="Elite B Tax Services <you@gmail.com>"
# Where website inquiries (Subscribe pop-up) are emailed. Defaults to EMAIL_FROM.
NOTIFY_EMAIL=

# ── File storage ────────────────────────────────────────────
# Local disk — fine for development and for a VPS with a persistent disk.
UPLOAD_DIR=./.data/uploads
# On Vercel the filesystem is wiped on every deploy, so set S3_BUCKET and the
# keys below. Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, Supabase.
# S3_BUCKET=elitebtax-documents
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
# Only for non-AWS providers (R2 / Spaces / Supabase):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ── Optional ────────────────────────────────────────────────
# POST every new lead / inquiry to your CRM or automation tool
# LEAD_WEBHOOK_URL=

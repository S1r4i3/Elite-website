NEXT_PUBLIC_SITE_URL=https://www.elitebtax.com
APP_URL=https://www.elitebtax.com

# ── Supabase (database + auth + file storage) ───────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Server-side only. Bypasses row-level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Private bucket holding client tax documents
SUPABASE_DOCUMENTS_BUCKET=client-documents

# ── Admin ───────────────────────────────────────────────────
# Password for the built-in /admin pages on the website
ADMIN_PASSWORD=
# Bearer token the separate admin dashboard uses for /api/v1/admin/*
#   openssl rand -hex 32
ADMIN_API_TOKEN=

# ── Email ───────────────────────────────────────────────────
# Supabase sends the verification and password-reset emails itself.
# SMTP below is only for the extra notifications this site sends:
# "your draft estimation is ready" and the Subscribe pop-up alerts.
# Set the same credentials under Supabase → Authentication → Emails → SMTP
# so account emails come from your own address too.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_FROM="Elite B Tax Services <you@gmail.com>"
NOTIFY_EMAIL=

# ── Optional ────────────────────────────────────────────────
# Search-console verification
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# POST every new lead / inquiry to your CRM
# LEAD_WEBHOOK_URL=

# ── Legacy (only if you are NOT using Supabase) ─────────────
# DATABASE_URL=postgres://user:password@host:5432/elite_tax
# DATABASE_SSL=true
# UPLOAD_DIR=./.data/uploads
